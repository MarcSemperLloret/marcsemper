---
import { publishedCourses, courseText, type Lang } from "@/data/teaching";

/**
 * The box that searches the teaching material.
 *
 * It ships hidden and is revealed by `/teaching-search.js`, so a reader without
 * JavaScript is never shown a control that cannot work. The strings and the
 * course names travel as data attributes because the site's Content-Security-
 * Policy allows no inline script to carry them.
 */
interface Props {
  lang: Lang;
  /** Restrict the search to one course. Omitted, it searches everything. */
  course?: string;
}

const { lang, course } = Astro.props;
const isSpanish = lang === "es";

const t = isSpanish
  ? {
      label: "Buscar en el material",
      placeholder: course
        ? "Buscar en esta asignatura…"
        : "Buscar una sesión: grid, formularios, DNS…",
      submit: "Buscar",
      hint: "Busca por título de sesión o por lo que hay dentro de ella.",
      searching: "Buscando…",
      one: "1 resultado",
      many: "%s resultados",
      none: "Sin resultados para «%s»",
      failed: "No se ha podido cargar el índice de búsqueda."
    }
  : {
      label: "Search the material",
      placeholder: course
        ? "Search this course…"
        : "Search for a class: grid, forms, DNS…",
      submit: "Search",
      hint: "Search by class title or by what is inside it.",
      searching: "Searching…",
      one: "1 result",
      many: "%s results",
      none: "No results for “%s”",
      failed: "The search index could not be loaded."
    };

const courseNames = Object.fromEntries(
  publishedCourses.map((entry) => [entry.slug, courseText(entry, lang).title])
);

const strings = JSON.stringify({
  searching: t.searching,
  one: t.one,
  many: t.many,
  none: t.none,
  failed: t.failed
});
---

<div
  class="teaching-search"
  data-teaching-search
  data-course={course}
  data-courses={JSON.stringify(courseNames)}
  data-strings={strings}
  hidden
>
  <form role="search">
    <label class="search-field">
      <span class="visually-hidden">{t.label}</span>
      <input type="search" name="q" placeholder={t.placeholder} autocomplete="off" />
    </label>
    <button class="button primary" type="submit">{t.submit}</button>
  </form>
  <p class="search-hint">{t.hint}</p>
  <p class="search-status" data-search-status aria-live="polite"></p>
  <div data-search-results></div>
</div>

<script src="/teaching-search.js" defer is:inline></script>

<style>
  .teaching-search {
    margin: 0 0 46px;
  }

  .teaching-search form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .search-field {
    flex: 1 1 280px;
  }

  .teaching-search input {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.95rem;
  }

  .teaching-search input:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
  }

  .search-hint {
    margin: 10px 0 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .search-status {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .teaching-search :global(.search-results) {
    margin: 8px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .teaching-search :global(.search-results a) {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease, padding-left 160ms ease;
  }

  .teaching-search :global(.search-results a:hover) {
    color: var(--blue-dark);
    padding-left: 8px;
  }

  .teaching-search :global(.search-label) {
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .teaching-search :global(.search-body) {
    display: grid;
    gap: 4px;
  }

  .teaching-search :global(.search-title) {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .teaching-search :global(.search-body small) {
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    .teaching-search :global(.search-results a) {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
