---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TeachingSearch from "@/components/TeachingSearch.astro";
import {
  isExternalResource,
  resourceKindLabel,
  formatTeachingDate,
  courseText,
  sectionText,
  resourceText,
  teachingBase,
  type Lang,
  type TeachingCourse,
  type TeachingResource
} from "@/data/teaching";
import {
  getCourseUnits,
  getLessons,
  lessonGroups,
  lessonLabel,
  lessonPath,
  lessonsOfUnit,
  unitPath,
  unitLabel
} from "@/data/units";
import { site } from "@/data/site";

interface Props {
  course: TeachingCourse;
  lang: Lang;
}

const { course, lang } = Astro.props;
const isSpanish = lang === "es";
const base = teachingBase(lang);
const alternatePath = isSpanish
  ? `/teaching/${course.slug}/`
  : `/es/docencia/${course.slug}/`;

const text = courseText(course, lang);
const announcements = course.announcements ?? [];
const units = await getCourseUnits(course.slug);
const lessons = await getLessons();
const looseUnits = units.filter(
  (unit) =>
    !unit.entry.data.section ||
    !course.sections.some((section) => section.id === unit.entry.data.section)
);
// The section titles are translated, but the material itself may be published
// only in Spanish. Say so rather than letting the English page imply otherwise.
const materialIsSpanishOnly =
  !isSpanish && units.length > 0 && units.every((unit) => unit.lang !== "en");

const t = isSpanish
  ? {
      backLabel: "Docencia",
      heroEyebrow: "Material docente",
      archived: "Curso archivado",
      aboutEyebrow: "Sobre la asignatura",
      aboutTitle: "Contenido de la asignatura.",
      updated: (date: string) => `Material actualizado el ${date}.`,
      sectionsNav: "Bloques de la asignatura",
      onThisPage: "En esta página",
      planEyebrow: "Al terminar el módulo",
      planTitle: "Lo que serás capaz de hacer.",
      milestones: "Mapa global del proyecto",
      announcements: "Avisos de la asignatura",
      documentsEyebrow: "Documentos de la asignatura",
      documentsTitle: "Material general.",
      contentsEyebrow: "Contenidos",
      contentsTitle: "Material por bloques.",
      sectionsEmpty:
        "Todavía no se ha publicado el material de esta asignatura. Se irá publicando bloque a bloque durante el curso.",
      sectionPending: "Material todavía no publicado.",
      otherUnits: "Otras unidades",
      footerEyebrow: "Registro oficial",
      footerTitle: "Guía docente y evaluación.",
      footerBody:
        "El temario, los criterios de evaluación y las fechas son los que publica el centro. Esta página solo aloja material de apoyo.",
      officialGuide: "Guía docente oficial",
      deliverable: "Entrega"
    }
  : {
      backLabel: "Teaching",
      heroEyebrow: "Course material",
      archived: "Archived course",
      aboutEyebrow: "About the course",
      aboutTitle: "What this course covers.",
      updated: (date: string) => `Material last updated on ${date}.`,
      sectionsNav: "Course sections",
      onThisPage: "On this page",
      planEyebrow: "By the end of the module",
      planTitle: "What you will be able to do.",
      milestones: "Whole-project roadmap",
      announcements: "Course notes",
      documentsEyebrow: "Course documents",
      documentsTitle: "General material.",
      contentsEyebrow: "Contents",
      contentsTitle: "Material by section.",
      sectionsEmpty:
        "The material for this course has not been released yet. It will be published section by section during the term.",
      sectionPending: "Material not published yet.",
      otherUnits: "Other units",
      footerEyebrow: "Official record",
      footerTitle: "Course guide and assessment.",
      footerBody:
        "Syllabus, assessment criteria and deadlines are those published by the teaching centre. This page only hosts supporting material.",
      officialGuide: "Official course guide",
      deliverable: "Deliverable"
    };

/**
 * The course route: one step per block, in teaching order. The duration is
 * read from the block's first unit so it stays in sync with the unit page
 * rather than being repeated here.
 */
const route = course.sections.map((section) => {
  const first = units.find((unit) => unit.entry.data.section === section.id);
  return {
    id: section.id,
    number: section.number,
    ...sectionText(section, lang),
    duration: first?.entry.data.duration
  };
});

const jsonLd = {
  "@type": "Course",
  // Both language versions describe the same course, so they share one
  // canonical id and differ in `url`.
  "@id": `${site.url}/teaching/${course.slug}/#course`,
  url: `${site.url}${base}/${course.slug}/`,
  name: text.title,
  description: text.summary,
  inLanguage: lang,
  courseCode: course.code,
  about: text.topics,
  ...(text.institution
    ? { provider: { "@type": "EducationalOrganization", name: text.institution } }
    : {}),
  instructor: { "@id": `${site.url}/#person` },
  ...(course.updatedAt ? { dateModified: course.updatedAt } : {})
};

const resourceMeta = (resource: TeachingResource) =>
  [resource.format, resource.date && formatTeachingDate(resource.date, lang)]
    .filter(Boolean)
    .join(" · ");
---

<BaseLayout
  lang={lang}
  title={text.title}
  description={text.summary}
  jsonLd={jsonLd}
  alternatePath={alternatePath}
>
  <header class="course-hero">
    <div class="container">
      <a class="back-link" href={`${base}/`}>← {t.backLabel}</a>
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>{text.title}</h1>
      <p class="course-summary">{text.summary}</p>
      <div class="course-meta">
        <span>{course.term}</span>
        {text.level && <span>{text.level}</span>}
        {(isSpanish ? course.hoursEs : course.hours) && (
          <span>{isSpanish ? course.hoursEs : course.hours}</span>
        )}
        {course.code && <span>{course.code}</span>}
        {text.institution && <span>{text.institution}</span>}
        {course.status === "archived" && <span class="archived">{t.archived}</span>}
      </div>
    </div>
  </header>

  <section class="page-section">
    <div class="container course-overview">
      <div>
        <p class="eyebrow">{t.aboutEyebrow}</p>
        <h2 class="section-title">{t.aboutTitle}</h2>
        {course.updatedAt && (
          <p class="updated">{t.updated(formatTeachingDate(course.updatedAt, lang))}</p>
        )}
      </div>
      <div class="prose">
        <p>{text.overview}</p>
        {text.topics.length > 0 && (
          <ul class="topic-list">
            {text.topics.map((topic) => <li>{topic}</li>)}
          </ul>
        )}
        {course.sections.length > 1 && (
          <nav class="section-nav" aria-label={t.sectionsNav}>
            <p>{t.onThisPage}</p>
            <ul>
              {course.sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>
                    {section.number ? `${section.number} · ` : ""}
                    {sectionText(section, lang).title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>
  </section>

  {(text.outcomes.length > 0 || route.length > 1) && (
    <section class="course-plan">
      <div class="container">
        <p class="eyebrow">{t.planEyebrow}</p>
        <h2 class="section-title">{t.planTitle}</h2>
        {text.outcomes.length > 0 && (
          <ul class="outcome-list">
            {text.outcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
        )}
        {route.length > 1 && (
          <ol class="course-route">
            {route.map((step, index) => (
              <Fragment>
                {step.phase && step.phase !== route[index - 1]?.phase && (
                  <li class="route-phase"><span>{step.phase}</span></li>
                )}
                <li>
                  <a href={`#${step.id}`}>
                    <span class="route-number">{step.number}</span>
                    {step.verb && <span class="route-verb">{step.verb}</span>}
                    <span class="route-title">{step.title}</span>
                    {step.duration && <span class="route-duration">{step.duration}</span>}
                  </a>
                </li>
              </Fragment>
            ))}
          </ol>
        )}
        {text.milestones.length > 0 && (
          <div class="course-milestones">
            <p>{t.milestones}</p>
            <ul>
              {text.milestones.map((milestone) => <li>{milestone}</li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  {announcements.length > 0 && (
    <section class="announcements">
      <div class="container">
        <p class="eyebrow">{t.announcements}</p>
        <ul>
          {announcements.map((announcement) => (
            <li>
              <time datetime={announcement.date}>
                {formatTeachingDate(announcement.date, lang)}
              </time>
              <p>{isSpanish ? announcement.textEs : announcement.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {course.resources.length > 0 && (
    <section class="course-resources">
      <div class="container">
        <p class="eyebrow">{t.documentsEyebrow}</p>
        <h2 class="section-title">{t.documentsTitle}</h2>
        <ul class="resource-list">
          {course.resources.map((resource) => {
            const info = resourceText(resource, lang);
            return (
              <li>
                <a
                  href={resource.href}
                  target={isExternalResource(resource.href) ? "_blank" : undefined}
                  rel={isExternalResource(resource.href) ? "noopener noreferrer" : undefined}
                >
                  <span class="resource-kind">{resourceKindLabel(resource.kind, lang)}</span>
                  <span class="resource-body">
                    <span class="resource-label">{info.label}</span>
                    {info.description && <small>{info.description}</small>}
                  </span>
                  {resourceMeta(resource) && (
                    <span class="resource-meta">{resourceMeta(resource)}</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <section class="sections-block">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">{t.contentsEyebrow}</p>
          <h2 class="section-title">{t.contentsTitle}</h2>
        </div>
      </div>

      <TeachingSearch lang={lang} course={course.slug} />

      {materialIsSpanishOnly && (
        <p class="language-notice">
          This module is taught in Spanish and its material is published in
          Spanish. The section titles below are translated for reference.
        </p>
      )}

      {course.sections.length === 0 ? (
        <p class="sections-empty">{t.sectionsEmpty}</p>
      ) : (
        <div class="section-list">
          {course.sections.map((section, index) => {
            const info = sectionText(section, lang);
            const sectionUnits = units.filter(
              (unit) => unit.entry.data.section === section.id
            );
            return (
              <Fragment>
                {info.phase && (index === 0 || info.phase !== sectionText(course.sections[index - 1], lang).phase) && (
                  <div class="section-phase">{info.phase}</div>
                )}
                <article id={section.id}>
                  <div class="section-index">{section.number ?? "—"}</div>
                  <div>
                  <h3>{info.title}</h3>
                  {info.description && <p>{info.description}</p>}
                  {sectionUnits.length > 0 && (
                    <ul class="unit-list">
                      {sectionUnits.map((unit) => (
                        <li class="unit-entry">
                          <a href={unitPath(unit)}>
                            <span class="unit-kind">
                              {unitLabel(unit)}
                              {!isSpanish && unit.lang !== "en" && " · in Spanish"}
                            </span>
                            <span class="unit-body">
                              <span class="unit-title">{unit.entry.data.title}</span>
                              <small>{unit.entry.data.summary}</small>
                            </span>
                            {unit.entry.data.duration && (
                              <span class="unit-meta">{unit.entry.data.duration}</span>
                            )}
                          </a>
                          {unit.entry.data.deliverable && (
                            <p class="unit-deliverable">
                              <b>{t.deliverable}</b> {unit.entry.data.deliverable}
                            </p>
                          )}
                          {/* The whole course as one index: every class of every
                              unit is one click from here, not two. */}
                          {lessonGroups(lessonsOfUnit(lessons, unit.entry.id)).map((block) => (
                            <div>
                              {block.group && <p class="course-week">{block.group}</p>}
                              <ol class="course-lessons">
                                {block.lessons.map((lesson) => (
                                  <li>
                                    <a href={lessonPath(lesson)}>
                                      <span class="lesson-number">{lessonLabel(lesson)}</span>
                                      <span>{lesson.entry.data.title}</span>
                                    </a>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          ))}
                        </li>
                      ))}
                    </ul>
                  )}
                  {section.resources.length === 0 && sectionUnits.length === 0 ? (
                    <p class="section-pending">{t.sectionPending}</p>
                  ) : section.resources.length === 0 ? null : (
                    <ul class="resource-list">
                      {section.resources.map((resource) => {
                        const file = resourceText(resource, lang);
                        return (
                          <li>
                            <a
                              href={resource.href}
                              target={isExternalResource(resource.href) ? "_blank" : undefined}
                              rel={isExternalResource(resource.href) ? "noopener noreferrer" : undefined}
                            >
                              <span class="resource-kind">{resourceKindLabel(resource.kind, lang)}</span>
                              <span class="resource-body">
                                <span class="resource-label">{file.label}</span>
                                {file.description && <small>{file.description}</small>}
                              </span>
                              {resourceMeta(resource) && (
                                <span class="resource-meta">{resourceMeta(resource)}</span>
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                  </div>
                </article>
              </Fragment>
            );
          })}
        </div>
      )}

      {looseUnits.length > 0 && (
        <div class="container loose-units">
          <p class="eyebrow">{t.otherUnits}</p>
          <ul class="unit-list">
            {looseUnits.map((unit) => (
              <li>
                <a href={unitPath(unit)}>
                  <span class="unit-kind">
                    {unitLabel(unit)}
                    {!isSpanish && unit.lang !== "en" && " · in Spanish"}
                  </span>
                  <span class="unit-body">
                    <span class="unit-title">{unit.entry.data.title}</span>
                    <small>{unit.entry.data.summary}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="course-footer">
    <div class="container footer-grid">
      <div>
        <p class="eyebrow">{t.footerEyebrow}</p>
        <h2>{t.footerTitle}</h2>
      </div>
      <div>
        <p>{t.footerBody}</p>
        {course.officialUrl && (
          <a class="button primary" href={course.officialUrl} target="_blank" rel="noopener">
            {t.officialGuide}
          </a>
        )}
        <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .course-hero {
    padding: 80px 0 70px;
    color: var(--white);
    background:
      radial-gradient(circle at 83% 35%, rgba(235, 93, 68, 0.4), transparent 19rem),
      var(--ink);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 45px;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 750;
  }

  .back-link:hover {
    color: var(--white);
  }

  .course-hero .eyebrow {
    color: var(--gold);
  }

  .course-hero h1 {
    max-width: 1000px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .course-summary {
    max-width: 700px;
    margin: 28px 0 40px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1.06rem;
  }

  .course-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .course-meta span {
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .course-meta .archived {
    color: var(--ink);
    border-color: var(--gold);
    background: var(--gold);
  }

  .course-plan {
    padding: 70px 0 10px;
  }

  .outcome-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 46px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .outcome-list li {
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .course-route {
    margin: 54px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: route-step;
  }

  .course-route li {
    position: relative;
    padding-left: 34px;
  }

  /* The rail that turns seven separate blocks into one path. */
  .course-route li::before {
    position: absolute;
    top: 26px;
    bottom: -12px;
    left: 5px;
    width: 1px;
    background: var(--line-strong);
    content: "";
  }

  .course-route li:last-child::before {
    display: none;
  }

  .course-route li::after {
    position: absolute;
    top: 22px;
    left: 0;
    width: 11px;
    height: 11px;
    border: 1px solid var(--blue);
    border-radius: 100px;
    background: var(--paper);
    content: "";
  }

  .course-route .route-phase {
    padding: 34px 0 8px;
    color: var(--blue-dark);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .course-route .route-phase::before,
  .course-route .route-phase::after {
    display: none;
  }

  .course-milestones {
    margin-top: 64px;
    padding: 30px;
    border: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  .course-milestones > p {
    margin: 0 0 18px;
    color: var(--blue-dark);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .course-milestones ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-milestones li {
    position: relative;
    padding: 10px 0 10px 30px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .course-milestones li::before {
    position: absolute;
    top: 11px;
    left: 0;
    width: 14px;
    height: 14px;
    border: 1px solid var(--line-strong);
    content: "";
  }

  .course-route a {
    display: grid;
    grid-template-columns: 46px 118px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .course-route a:hover .route-title {
    color: var(--blue-dark);
  }

  .route-number {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .route-verb {
    color: var(--coral);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .route-title {
    font-family: var(--serif);
    font-size: 1.14rem;
    line-height: 1.25;
  }

  .route-duration {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 750;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .course-route a {
      grid-template-columns: 46px 1fr;
      gap: 4px 14px;
    }

    .route-title,
    .route-duration {
      grid-column: 2;
    }
  }

  .course-overview {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 90px;
  }

  .updated {
    margin: 22px 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .section-nav {
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .section-nav p {
    margin: 0 0 12px;
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-nav ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-nav a {
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .section-nav a:hover {
    text-decoration: underline;
  }

  .announcements {
    padding: 60px 0;
    background: var(--paper-deep);
  }

  .announcements ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .announcements li {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .announcements time {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .announcements p {
    margin: 0;
  }

  .course-resources {
    padding: 80px 0;
  }

  .resource-list {
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .resource-list a {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .resource-list a:hover {
    color: var(--blue-dark);
  }

  .resource-kind {
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resource-body {
    display: grid;
    gap: 4px;
  }

  .resource-label {
    font-weight: 700;
  }

  .resource-body small {
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 400;
  }

