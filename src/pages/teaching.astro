---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArrowLink from "@/components/ArrowLink.astro";
import {
  publishedCourses,
  currentCourses,
  archivedCourses,
  courseResourceCount,
  formatTeachingDate
} from "@/data/teaching";
import {
  getSessions,
  sessionsOfCourse,
  latestSessionDate
} from "@/data/sessions";
import { site } from "@/data/site";

const sessions = await getSessions();

/**
 * A course card counts everything a student can open: the sessions written for
 * the course and the files published under it.
 */
function materialSummary(course: (typeof publishedCourses)[number]): string {
  const sessionCount = sessionsOfCourse(sessions, course.slug).length;
  const fileCount = courseResourceCount(course);
  const parts: string[] = [];

  if (sessionCount > 0) {
    parts.push(sessionCount === 1 ? "1 session" : `${sessionCount} sessions`);
  }
  if (fileCount > 0) {
    parts.push(fileCount === 1 ? "1 file" : `${fileCount} files`);
  }

  return parts.length > 0 ? parts.join(" · ") : "No material published yet";
}

function updatedLabel(course: (typeof publishedCourses)[number]): string | undefined {
  const date =
    course.updatedAt ?? latestSessionDate(sessionsOfCourse(sessions, course.slug));
  return date ? ` · updated ${formatTeachingDate(date, "en")}` : undefined;
}

const teachingJsonLd = {
  "@type": "CollectionPage",
  "@id": `${site.url}/teaching/#teaching`,
  url: `${site.url}/teaching/`,
  name: "Teaching",
  description:
    "Course material published by Marc Semper Lloret for the subjects and vocational training modules he teaches.",
  inLanguage: "en",
  author: { "@id": `${site.url}/#person` },
  hasPart: publishedCourses.map((course) => ({
    "@type": "Course",
    "@id": `${site.url}/teaching/${course.slug}/#course`,
    url: `${site.url}/teaching/${course.slug}/`,
    name: course.title,
    description: course.summary,
    ...(course.institution
      ? { provider: { "@type": "EducationalOrganization", name: course.institution } }
      : {})
  }))
};
---

<BaseLayout
  title="Teaching"
  description="Teaching material: notes, slides, exercises, notebooks and reading lists for the subjects and modules taught by Marc Semper Lloret."
  jsonLd={teachingJsonLd}
  alternatePath="/es/docencia/"
>
  <header class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Teaching</p>
        <h1 class="page-title">Teaching material.</h1>
      </div>
      <p class="page-intro">
        A single, stable place for the material of the subjects and modules I
        teach: notes, slides, exercises, notebooks and reading lists, organised
        by subject and by section.
      </p>
    </div>
  </header>

  <section class="courses-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Courses</p>
          <h2 class="section-title">Subjects and material.</h2>
        </div>
        <p>
          Each subject has its own page, with the material grouped into the
          sections that suit it.
        </p>
      </div>

      {publishedCourses.length === 0 ? (
        <div class="empty-state">
          <p class="empty-mark" aria-hidden="true">T</p>
          <div>
            <h3>Material in preparation.</h3>
            <p>
              No course material has been published yet. The subjects I teach
              and their material will appear here as soon as they are released
              for the current academic year.
            </p>
            <p>
              In the meantime, students can reach me by email for anything
              related to a course.
            </p>
            <a class="button primary" href={`mailto:${site.email}`}>
              Write to {site.email}
            </a>
          </div>
        </div>
      ) : (
        <div class="course-list">
          {currentCourses.map((course) => (
            <article>
              <div class="course-meta">
                <span>{course.term}</span>
                {course.code && <span>{course.code}</span>}
              </div>
              <div>
                <h3>
                  <a href={`/teaching/${course.slug}/`}>{course.title}</a>
                </h3>
                {course.institution && (
                  <p class="course-level">{course.institution}</p>
                )}
                <p>{course.summary}</p>
                {course.topics.length > 0 && (
                  <ul class="topic-list">
                    {course.topics.map((topic) => <li>{topic}</li>)}
                  </ul>
                )}
                <p class="course-stats">
                  {materialSummary(course)}
                  {updatedLabel(course)}
                </p>
                <ArrowLink href={`/teaching/${course.slug}/`}>
                  Open course material
                </ArrowLink>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  {archivedCourses.length > 0 && (
    <section class="page-section archive-section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Archive</p>
            <h2 class="section-title">Previous academic years.</h2>
          </div>
          <p>
            Kept for reference. Content and assessment may have changed since
            these courses were taught.
          </p>
        </div>
        <ul class="archive-list">
          {archivedCourses.map((course) => (
            <li>
              <a href={`/teaching/${course.slug}/`}>
                <span class="archive-term">{course.term}</span>
                <span>{course.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="teaching-contact">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2>Ask about a course.</h2>
      </div>
      <div>
        <p>
          For doubts about content, exercises or material, write from your
          student account and state the subject or module you are enrolled in.
        </p>
        <a class="button primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="text-link" href="/research/">Research programme ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The teaching index leads with the courses, so its hero stays out of the
     way instead of taking a full screen like the research pages. */
  .page-hero {
    padding: 74px 0 46px;
  }

  .page-title {
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
  }

  /* The hero aligns its two columns at the bottom, which reads well under a
     full-height display title. With this smaller one the intro is the taller
     column, so bottom alignment started it above the title. Align at the top. */
  .page-hero-grid {
    align-items: start;
  }

  .page-intro {
    margin-bottom: 0;
    padding-top: 10px;
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 56px 0 38px;
    }

    .page-title {
      font-size: clamp(2.3rem, 11vw, 3.4rem);
    }
  }

  .courses-section {
    padding: 105px 0;
    background: var(--paper-deep);
  }

  .empty-state {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    padding: 45px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .empty-mark {
    margin: 0;
    color: var(--coral);
    font-family: var(--serif);
    font-size: 5rem;
    line-height: 0.8;
  }

  .empty-state h3 {
    margin: 0 0 16px;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .empty-state p {
    max-width: 560px;
    color: var(--ink-soft);
  }

  .empty-state .button {
    margin-top: 18px;
  }

  .course-list {
    border-top: 1px solid var(--line-strong);
  }

  .course-list article {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    padding: 40px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .course-meta {
    display: grid;
    gap: 6px;
    align-content: start;
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .course-list h3 {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .course-list h3 a {
    color: inherit;
    text-decoration: none;
  }

  .course-list h3 a:hover {
    color: var(--blue-dark);
  }

  .course-level {
    margin: 0 0 14px;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 750;
  }

  .course-stats {
    margin: 0 0 18px;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .archive-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .archive-list a {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 30px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    font-size: 1.2rem;
    transition: color 160ms ease;
  }

  .archive-list a:hover {
    color: var(--blue-dark);
  }

  .archive-term {
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .teaching-contact {
    padding: 100px 0;
    color: var(--white);
    background: var(--ink);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 100px;
  }

  .teaching-contact .eyebrow {
    color: var(--gold);
  }

  .teaching-contact h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .teaching-contact p {
    margin-top: 0;
    color: rgba(255, 255, 255, 0.66);
  }

  .teaching-contact .text-link {
    display: block;
    margin-top: 18px;
    color: var(--white);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 640px) {
    .empty-state,
    .course-list article,
    .archive-list a {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .archive-list a {
      gap: 6px;
    }

    .empty-state {
      padding: 30px;
    }
  }
</style>
