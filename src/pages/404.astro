---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="not-found">
    <div class="container">
      <span>404</span>
      <p class="eyebrow">Page not found</p>
      <h1>This coordinate falls outside the graph.</h1>
      <p>The page may have moved, or the address may be incomplete.</p>
      <a class="button primary" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 72vh;
    padding: 100px 0;
    place-items: center;
    text-align: center;
  }

  .not-found span {
    color: var(--coral);
    font-family: var(--serif);
    font-size: clamp(7rem, 20vw, 16rem);
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .not-found .eyebrow {
    justify-content: center;
    margin-top: 45px;
  }

  .not-found h1 {
    max-width: 800px;
    margin: 0 auto;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .not-found > .container > p:not(.eyebrow) {
    color: var(--ink-soft);
  }

  .not-found .button {
    margin-top: 24px;
  }
</style>
