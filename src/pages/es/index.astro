---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArrowLink from "@/components/ArrowLink.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { researchAreas, site } from "@/data/site";
import { publications, selectedPublications } from "@/data/publications";

const homeJsonLd = {
  "@type": "ProfilePage",
  "@id": `${site.url}/es/#profile`,
  url: `${site.url}/es/`,
  name: `${site.name} — perfil académico`,
  inLanguage: "es",
  mainEntity: { "@id": `${site.url}/#person` },
  dateModified: site.lastUpdated
};
---

<BaseLayout
  lang="es"
  description={site.shortDescriptionEs}
  jsonLd={homeJsonLd}
  alternatePath="/"
>
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Investigador · Universidad de Alicante</p>
        <h1>
          <span>Marc Semper Lloret</span>
          IA fiable para un mundo <em>en movimiento.</em>
        </h1>
        <p class="hero-intro">
          Estudio cómo los sistemas de inteligencia artificial espacio-temporal
          pueden producir predicciones fiables cuando los sensores, los datos y
          las condiciones de despliegue son imperfectos.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/es/publicaciones/">Ver publicaciones</a>
          <a class="button" href="/es/investigacion/">Programa de investigación</a>
        </div>
      </div>
      <figure>
        <img
          src={site.portrait}
          width="500"
          height="500"
          alt="Retrato de Marc Semper Lloret"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <strong>Marc Semper Lloret</strong>
          <span>Publica como Marc Semper</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="themes" aria-label="Temas de investigación">
    <div class="container">
      <span>IA espacio-temporal</span>
      <span>Redes neuronales de grafos</span>
      <span>Predicción ambiental</span>
      <span>Evaluación fiable</span>
    </div>
  </section>

  <section class="page-section">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Perspectiva de investigación</p>
        <h2 class="section-title">Una predicción solo es útil si la decisión resiste la realidad.</h2>
      </div>
      <div class="prose">
        <p>
          Marc Semper Lloret es profesor asociado e investigador del
          Departamento de Ciencia de la Computación e Inteligencia Artificial de
          la Universidad de Alicante, y miembro del grupo ANVIDA.
        </p>
        <p>
          Su trabajo conecta aprendizaje en grafos, observación ambiental y
          evaluación robusta para comprender si el modelo elegido sigue siendo
          defendible ante incertidumbre realista.
        </p>
        <ArrowLink href="/es/investigacion/">Conocer el programa de investigación</ArrowLink>
      </div>
    </div>
  </section>

  <section class="research-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Áreas de investigación</p>
          <h2 class="section-title">De las redes de sensores a las decisiones de despliegue.</h2>
        </div>
      </div>
      <div class="research-grid">
        {researchAreas.map((area) => (
          <article>
            <span>{area.number}</span>
            <h3>{area.titleEs}</h3>
            <p>{area.descriptionEs}</p>
            <ArrowLink href={`/es/investigacion/${area.slug}/`}>Explorar el área</ArrowLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Trabajos seleccionados</p>
          <h2 class="section-title">Publicaciones recientes.</h2>
        </div>
        <ArrowLink href="/es/publicaciones/">Ver los {publications.length} artículos</ArrowLink>
      </div>
      {selectedPublications.map((publication, index) => (
        <PublicationCard publication={publication} index={index} lang="es" />
      ))}
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Colaboración</p>
        <h2>Investigación conectada con problemas ambientales reales.</h2>
      </div>
      <div>
        <p>
          Interés en datos ambientales a gran escala, calidad de redes de
          sensores, predicción basada en grafos y robustez ante cambios de
          distribución.
        </p>
        <a class="button primary" href={`mailto:${site.email}`}>Contactar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding: 76px 0;
    background:
      radial-gradient(circle at 12% 18%, rgba(40, 87, 223, 0.12), transparent 23rem),
      var(--paper);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.65fr;
    gap: 70px;
    align-items: center;
  }

  h1 {
    max-width: 900px;
    margin: 18px 0 30px;
    font-family: var(--serif);
    font-size: clamp(4rem, 8vw, 8.2rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.91;
  }

  h1 > span {
    display: block;
    margin-bottom: 20px;
    color: var(--blue);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  h1 em {
    color: var(--coral);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  figure {
    margin: 0;
    border: 1px solid var(--line-strong);
    background: var(--paper-deep);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    padding: 16px;
    color: var(--ink-soft);
    font-size: 0.7rem;
  }

  .themes {
    padding: 22px 0;
    color: var(--white);
    background: var(--ink);
  }

  .themes .container {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    justify-content: space-between;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .intro-grid,
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 90px;
  }

  .prose {
    color: var(--ink-soft);
  }

  .research-section {
    padding: 110px 0;
    color: var(--white);
    background: var(--ink);
  }

  .research-section .eyebrow {
    color: var(--gold);
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 50px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .research-grid article {
    padding: 34px;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .research-grid article > span {
    color: var(--coral);
    font-family: var(--serif);
  }

  .research-grid h3 {
    margin: 40px 0 15px;
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 400;
  }

  .research-grid p {
    color: rgba(255, 255, 255, 0.62);
  }

  .research-grid :global(.arrow-link) {
    color: var(--white);
  }

  .contact-section {
    padding: 100px 0;
    color: var(--white);
    background: var(--blue);
  }

  .contact-section h2 {
    margin: 8px 0 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .contact-section p {
    color: rgba(255, 255, 255, 0.75);
  }

  .contact-section .button {
    color: var(--ink);
    border-color: var(--white);
    background: var(--white);
  }

  @media (max-width: 800px) {
    .hero-grid,
    .intro-grid,
    .contact-grid,
    .research-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    h1 {
      font-size: clamp(3.25rem, 15vw, 4.8rem);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hero-actions .button {
      width: 100%;
      text-align: center;
      white-space: normal;
    }
  }
</style>
