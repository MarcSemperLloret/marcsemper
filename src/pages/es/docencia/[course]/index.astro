---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  publishedCourses,
  isExternalResource,
  resourceKindLabel,
  formatTeachingDate,
  type TeachingCourse,
  type TeachingResource
} from "@/data/teaching";
import { getCourseSessions, sessionPath, sessionLabel } from "@/data/sessions";
import { site } from "@/data/site";

export function getStaticPaths() {
  return publishedCourses.map((course) => ({
    params: { course: course.slug },
    props: { course }
  }));
}

interface Props {
  course: TeachingCourse;
}

const { course } = Astro.props;
const announcements = course.announcements ?? [];
const sessions = await getCourseSessions(course.slug);
const looseSessions = sessions.filter(
  (session) =>
    !session.entry.data.section ||
    !course.sections.some((section) => section.id === session.entry.data.section)
);

/**
 * The course route: one step per block, in teaching order. The duration is
 * read from the block's first session so it stays in sync with the unit page
 * rather than being repeated here.
 */
const route = course.sections.map((section) => {
  const first = sessions.find(
    (session) => session.entry.data.section === section.id
  );
  return {
    id: section.id,
    number: section.number,
    verb: section.verbEs ?? section.verb,
    title: section.titleEs,
    duration: first?.entry.data.duration
  };
});

const jsonLd = {
  "@type": "Course",
  "@id": `${site.url}/teaching/${course.slug}/#course`,
  url: `${site.url}/es/docencia/${course.slug}/`,
  name: course.titleEs,
  description: course.summaryEs,
  inLanguage: "es",
  courseCode: course.code,
  about: course.topicsEs,
  ...(course.institutionEs
    ? { provider: { "@type": "EducationalOrganization", name: course.institutionEs } }
    : {}),
  instructor: { "@id": `${site.url}/#person` },
  ...(course.updatedAt ? { dateModified: course.updatedAt } : {})
};

const resourceMeta = (resource: TeachingResource) =>
  [resource.format, resource.date && formatTeachingDate(resource.date, "es")]
    .filter(Boolean)
    .join(" · ");
---

<BaseLayout
  lang="es"
  title={course.titleEs}
  description={course.summaryEs}
  jsonLd={jsonLd}
  alternatePath={`/teaching/${course.slug}/`}
>
  <header class="course-hero">
    <div class="container">
      <a class="back-link" href="/es/docencia/">← Docencia</a>
      <p class="eyebrow">Material docente</p>
      <h1>{course.titleEs}</h1>
      <p class="course-summary">{course.summaryEs}</p>
      <div class="course-meta">
        <span>{course.term}</span>
        {course.code && <span>{course.code}</span>}
        {course.institutionEs && <span>{course.institutionEs}</span>}
        {course.status === "archived" && <span class="archived">Curso archivado</span>}
      </div>
    </div>
  </header>

  <section class="page-section">
    <div class="container course-overview">
      <div>
        <p class="eyebrow">Sobre la asignatura</p>
        <h2 class="section-title">Contenido de la asignatura.</h2>
        {course.updatedAt && (
          <p class="updated">
            Material actualizado el {formatTeachingDate(course.updatedAt, "es")}.
          </p>
        )}
      </div>
      <div class="prose">
        <p>{course.overviewEs}</p>
        {course.topicsEs.length > 0 && (
          <ul class="topic-list">
            {course.topicsEs.map((topic) => <li>{topic}</li>)}
          </ul>
        )}
        {course.sections.length > 1 && (
          <nav class="section-nav" aria-label="Bloques de la asignatura">
            <p>En esta página</p>
            <ul>
              {course.sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>
                    {section.number ? `${section.number} · ` : ""}{section.titleEs}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>
  </section>

  {((course.outcomesEs ?? []).length > 0 || route.length > 1) && (
    <section class="course-plan">
      <div class="container">
        <p class="eyebrow">Al terminar el módulo</p>
        <h2 class="section-title">Lo que serás capaz de hacer.</h2>
        {(course.outcomesEs ?? []).length > 0 && (
          <ul class="outcome-list">
            {(course.outcomesEs ?? []).map((outcome) => <li>{outcome}</li>)}
          </ul>
        )}
        {route.length > 1 && (
          <ol class="course-route">
            {route.map((step) => (
              <li>
                <a href={`#${step.id}`}>
                  <span class="route-number">{step.number}</span>
                  {step.verb && <span class="route-verb">{step.verb}</span>}
                  <span class="route-title">{step.title}</span>
                  {step.duration && <span class="route-duration">{step.duration}</span>}
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )}

  {announcements.length > 0 && (
    <section class="announcements">
      <div class="container">
        <p class="eyebrow">Avisos de la asignatura</p>
        <ul>
          {announcements.map((announcement) => (
            <li>
              <time datetime={announcement.date}>
                {formatTeachingDate(announcement.date, "es")}
              </time>
              <p>{announcement.textEs}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {course.resources.length > 0 && (
    <section class="course-resources">
      <div class="container">
        <p class="eyebrow">Documentos de la asignatura</p>
        <h2 class="section-title">Material general.</h2>
        <ul class="resource-list">
          {course.resources.map((resource) => (
            <li>
              <a
                href={resource.href}
                target={isExternalResource(resource.href) ? "_blank" : undefined}
                rel={isExternalResource(resource.href) ? "noopener noreferrer" : undefined}
              >
                <span class="resource-kind">{resourceKindLabel(resource.kind, "es")}</span>
                <span class="resource-body">
                  <span class="resource-label">{resource.labelEs}</span>
                  {resource.descriptionEs && <small>{resource.descriptionEs}</small>}
                </span>
                {resourceMeta(resource) && (
                  <span class="resource-meta">{resourceMeta(resource)}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="sections-block">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Contenidos</p>
          <h2 class="section-title">Material por bloques.</h2>
        </div>
      </div>

      {course.sections.length === 0 ? (
        <p class="sections-empty">
          Todavía no se ha publicado el material de esta asignatura. Se irá
          publicando bloque a bloque durante el curso.
        </p>
      ) : (
        <div class="section-list">
          {course.sections.map((section) => {
            const sectionSessions = sessions.filter(
              (session) => session.entry.data.section === section.id
            );
            return (
            <article id={section.id}>
              <div class="section-index">{section.number ?? "—"}</div>
              <div>
                <h3>{section.titleEs}</h3>
                {section.descriptionEs && <p>{section.descriptionEs}</p>}
                {sectionSessions.length > 0 && (
                  <ul class="session-list">
                    {sectionSessions.map((session) => (
                      <li>
                        <a href={sessionPath(session)}>
                          <span class="session-kind">
                            {sessionLabel(session)}
                          </span>
                          <span class="session-body">
                            <span class="session-title">{session.entry.data.title}</span>
                            <small>{session.entry.data.summary}</small>
                          </span>
                          {session.entry.data.duration && (
                            <span class="session-meta">{session.entry.data.duration}</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {section.resources.length === 0 && sectionSessions.length === 0 ? (
                  <p class="section-pending">Material todavía no publicado.</p>
                ) : section.resources.length === 0 ? null : (
                  <ul class="resource-list">
                    {section.resources.map((resource) => (
                      <li>
                        <a
                          href={resource.href}
                          target={isExternalResource(resource.href) ? "_blank" : undefined}
                          rel={isExternalResource(resource.href) ? "noopener noreferrer" : undefined}
                        >
                          <span class="resource-kind">{resourceKindLabel(resource.kind, "es")}</span>
                          <span class="resource-body">
                            <span class="resource-label">{resource.labelEs}</span>
                            {resource.descriptionEs && <small>{resource.descriptionEs}</small>}
                          </span>
                          {resourceMeta(resource) && (
                            <span class="resource-meta">{resourceMeta(resource)}</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
            );
          })}
        </div>
      )}

      {looseSessions.length > 0 && (
        <div class="container loose-sessions">
          <p class="eyebrow">Otras sesiones</p>
          <ul class="session-list">
            {looseSessions.map((session) => (
              <li>
                <a href={sessionPath(session)}>
                  <span class="session-kind">
                    {sessionLabel(session)}
                  </span>
                  <span class="session-body">
                    <span class="session-title">{session.entry.data.title}</span>
                    <small>{session.entry.data.summary}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="course-footer">
    <div class="container footer-grid">
      <div>
        <p class="eyebrow">Registro oficial</p>
        <h2>Guía docente y evaluación.</h2>
      </div>
      <div>
        <p>
          El temario, los criterios de evaluación y las fechas son los que
          publica el centro. Esta página solo aloja material de apoyo.
        </p>
        {course.officialUrl && (
          <a class="button primary" href={course.officialUrl} target="_blank" rel="noopener">
            Guía docente oficial
          </a>
        )}
        <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .course-hero {
    padding: 80px 0 70px;
    color: var(--white);
    background:
      radial-gradient(circle at 83% 35%, rgba(235, 93, 68, 0.4), transparent 19rem),
      var(--ink);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 45px;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 750;
  }

  .back-link:hover {
    color: var(--white);
  }

  .course-hero .eyebrow {
    color: var(--gold);
  }

  .course-hero h1 {
    max-width: 1000px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 6.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
    overflow-wrap: break-word;
  }

  .course-summary {
    max-width: 700px;
    margin: 28px 0 40px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1.06rem;
  }

  .course-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .course-meta span {
    padding: 5px 9px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.63rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .course-meta .archived {
    color: var(--ink);
    border-color: var(--gold);
    background: var(--gold);
  }

  .course-plan {
    padding: 70px 0 10px;
  }

  .outcome-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 46px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .outcome-list li {
    padding: 18px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .course-route {
    margin: 54px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: route-step;
  }

  .course-route li {
    position: relative;
    padding-left: 34px;
  }

  /* The rail that turns seven separate blocks into one path. */
  .course-route li::before {
    position: absolute;
    top: 26px;
    bottom: -12px;
    left: 5px;
    width: 1px;
    background: var(--line-strong);
    content: "";
  }

  .course-route li:last-child::before {
    display: none;
  }

  .course-route li::after {
    position: absolute;
    top: 22px;
    left: 0;
    width: 11px;
    height: 11px;
    border: 1px solid var(--blue);
    border-radius: 100px;
    background: var(--paper);
    content: "";
  }

  .course-route a {
    display: grid;
    grid-template-columns: 46px 118px 1fr auto;
    gap: 18px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .course-route a:hover .route-title {
    color: var(--blue-dark);
  }

  .route-number {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .route-verb {
    color: var(--coral);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .route-title {
    font-family: var(--serif);
    font-size: 1.14rem;
    line-height: 1.25;
  }

  .route-duration {
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 750;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .course-route a {
      grid-template-columns: 46px 1fr;
      gap: 4px 14px;
    }

    .route-title,
    .route-duration {
      grid-column: 2;
    }
  }

  .course-overview {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: 90px;
  }

  .updated {
    margin: 22px 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .topic-list li {
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .section-nav {
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .section-nav p {
    margin: 0 0 12px;
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-nav ul {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-nav a {
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .section-nav a:hover {
    text-decoration: underline;
  }

  .announcements {
    padding: 60px 0;
    background: var(--paper-deep);
  }

  .announcements ul {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .announcements li {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .announcements time {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .announcements p {
    margin: 0;
  }

  .course-resources {
    padding: 80px 0;
  }

  .resource-list {
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .resource-list a {
    display: grid;
    grid-template-columns: 130px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--ink);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .resource-list a:hover {
    color: var(--blue-dark);
  }

  .resource-kind {
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resource-body {
    display: grid;
    gap: 4px;
  }

  .resource-label {
    font-weight: 700;
  }

  .resource-body small {
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 400;
  }

  .resource-meta {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .sections-block {
    padding: 95px 0;
    background: var(--paper-deep);
  }

  .sections-empty {
    max-width: 640px;
    color: var(--ink-soft);
  }

  .section-list {
    border-top: 1px solid var(--line-strong);
  }

  .section-list article {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    padding: 40px 0;
    border-bottom: 1px solid var(--line-strong);
    scroll-margin-top: 90px;
  }

  .section-index {
    color: var(--coral);
    font-family: var(--serif);
    font-size: 1.5rem;
  }

  .section-list h3 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    overflow-wrap: break-word;
  }

  .section-list p {
    max-width: 620px;
    margin: 0;
    color: var(--ink-soft);
  }

  .section-pending {
    font-size: 0.88rem;
    font-style: italic;
  }

  .course-footer {
    padding: 95px 0;
    color: var(--white);
    background: var(--blue);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 90px;
  }

  .course-footer .eyebrow {
    color: var(--gold);
  }

  .course-footer h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .course-footer p {
    margin-top: 0;
    color: rgba(255, 255, 255, 0.74);
  }

  .course-footer .button {
    color: var(--ink);
    border-color: var(--white);
    background: var(--white);
  }

  .course-footer .text-link {
    display: block;
    margin-top: 18px;
    color: var(--white);
  }

  @media (max-width: 900px) {
    .course-overview,
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 640px) {
    .section-list article,
    .announcements li {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .section-list article {
      gap: 18px;
    }

    .resource-list a {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .resource-meta {
      white-space: normal;
    }
  }
</style>
