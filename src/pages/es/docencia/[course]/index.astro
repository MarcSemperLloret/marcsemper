---
import CoursePage from "@/components/CoursePage.astro";
import { publishedCourses, type TeachingCourse } from "@/data/teaching";

export function getStaticPaths() {
  return publishedCourses.map((course) => ({
    params: { course: course.slug },
    props: { course }
  }));
}

interface Props {
  course: TeachingCourse;
}

const { course } = Astro.props;
---

<CoursePage course={course} lang="es" />
