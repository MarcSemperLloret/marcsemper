---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import {
  publications
} from "@/data/publications";
import { formatSiteDate, site } from "@/data/site";

const publicationsByYear = publications.reduce((groups, publication) => {
  const group = groups.get(publication.year) ?? [];
  group.push(publication);
  groups.set(publication.year, group);
  return groups;
}, new Map<number, typeof publications>());
const years = [...publicationsByYear.keys()].sort((a, b) => b - a);
const publicationRecordReviewedEs = formatSiteDate("es-ES");

const jsonLd = {
  "@type": ["CollectionPage", "ItemList"],
  "@id": `${site.url}/es/publicaciones/#collection`,
  name: `Publicaciones de ${site.name}`,
  url: `${site.url}/es/publicaciones/`,
  inLanguage: "es",
  numberOfItems: publications.length,
  itemListElement: publications.map((publication, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `${site.url}/es/publicaciones/${publication.slug}/`,
    name: publication.title
  }))
};
---

<BaseLayout
  lang="es"
  title="Publicaciones"
  description="Registro completo de publicaciones científicas de Marc Semper sobre IA espacio-temporal, redes neuronales de grafos y predicción ambiental."
  jsonLd={jsonLd}
  alternatePath="/publications/"
>
  <header class="page-hero publications-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Registro académico</p>
        <h1 class="page-title">Publicaciones.</h1>
      </div>
      <div>
        <p class="page-intro">
          Archivo acumulativo de artículos revisados por pares sobre selección
          fiable de modelos, aprendizaje en grafos y predicción ambiental.
        </p>
        <div class="record-stats">
          <span><strong>{publications.length}</strong> artículos científicos</span>
          <span><strong>{years.length}</strong> años</span>
          <span><strong>{publications.length}</strong> registros DOI</span>
        </div>
      </div>
    </div>
  </header>

  <section class="publication-note">
    <div class="container note-grid">
      <p>
        <strong>Identidad de autor:</strong> Marc Semper Lloret publica su
        trabajo científico como <strong>Marc Semper</strong>. Registro revisado el
        {` ${publicationRecordReviewedEs}`}.
      </p>
      <div>
        <a href="/rss.xml">RSS</a>
        <a href={site.profiles.scholar} target="_blank" rel="noopener">Google Scholar</a>
        <a href={site.profiles.orcid} target="_blank" rel="noopener">ORCID</a>
      </div>
    </div>
  </section>

  <div class="container publication-years">
    {years.map((year) => (
      <section class="year-section" aria-labelledby={`year-${year}`}>
        <div class="year-heading">
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{publicationsByYear.get(year)?.length} artículos científicos</span>
        </div>
        <div class="year-publications">
          {publicationsByYear.get(year)?.map((publication, index) => (
            <PublicationCard publication={publication} index={index} lang="es" />
          ))}
        </div>
      </section>
    ))}
  </div>

  <section class="citation-help">
    <div class="container citation-help-grid">
      <div>
        <p class="eyebrow">Citación reproducible</p>
        <h2>Cada publicación tiene su propia vista permanente.</h2>
      </div>
      <p>
        Las páginas individuales proporcionan el registro bibliográfico completo, el resumen del autor, contexto en lenguaje claro, enlaces DOI y formato BibTeX exportable.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .publications-hero {
    background:
      radial-gradient(circle at 84% 20%, rgba(235, 93, 68, 0.12), transparent 18rem),
      var(--paper);
  }

  .record-stats {
    display: flex;
    gap: 28px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .record-stats span {
    color: var(--ink-soft);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .record-stats strong {
    margin-right: 3px;
    color: var(--blue);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 400;
  }

  .publication-note {
    padding: 24px 0;
    color: var(--white);
    background: var(--blue);
  }

  .note-grid {
    display: flex;
    gap: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .note-grid p {
    margin: 0;
    font-size: 0.8rem;
  }

  .note-grid > div {
    display: flex;
    gap: 24px;
  }

  .note-grid a {
    color: var(--white);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .publication-years {
    padding-top: 110px;
    padding-bottom: 120px;
  }

  .year-section {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 45px;
    margin-bottom: 100px;
  }

  .year-heading {
    position: sticky;
    top: 110px;
    align-self: start;
  }

  .year-heading h2 {
    margin: 0;
    color: var(--blue);
    font-family: var(--serif);
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .year-heading span {
    display: block;
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .citation-help {
    padding: 100px 0;
    background: var(--paper-deep);
  }

  .citation-help-grid {
    display: grid;
    grid-template-columns: 1fr 0.6fr;
    gap: 90px;
    align-items: end;
  }

  .citation-help h2 {
    max-width: 750px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .citation-help-grid > p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .year-section,
    .citation-help-grid {
      grid-template-columns: 1fr;
    }

    .year-heading {
      position: static;
    }

    .year-section {
      gap: 25px;
    }
  }

  @media (max-width: 640px) {
    .note-grid {
      align-items: flex-start;
      flex-direction: column;
    }

    .publication-years {
      padding-top: 80px;
    }
  }
</style>
