---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PublicationCard from "@/components/PublicationCard.astro";
import { publications } from "@/data/publications";
import { formatSiteDate, site } from "@/data/site";

const publicationsByYear = publications.reduce((groups, publication) => {
  const group = groups.get(publication.year) ?? [];
  group.push(publication);
  groups.set(publication.year, group);
  return groups;
}, new Map<number, typeof publications>());
const years = [...publicationsByYear.keys()].sort((a, b) => b - a);
const publicationRecordReviewedEs = formatSiteDate("es-ES");

const jsonLd = {
  "@type": ["CollectionPage", "ItemList"],
  "@id": `${site.url}/es/publicaciones/#collection`,
  name: `Publicaciones de ${site.name}`,
  url: `${site.url}/es/publicaciones/`,
  inLanguage: "es",
  numberOfItems: publications.length,
  itemListElement: publications.map((publication, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `${site.url}/es/publicaciones/${publication.slug}/`,
    name: publication.title
  }))
};
---

<BaseLayout
  lang="es"
  title="Publicaciones"
  description="Registro de publicaciones científicas de Marc Semper sobre IA espacio-temporal, redes neuronales de grafos y predicción ambiental."
  jsonLd={jsonLd}
  alternatePath="/publications/"
>
  <header class="page-hero publications-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Registro académico</p>
        <h1 class="page-title">Publicaciones.</h1>
      </div>
      <div>
        <p class="page-intro">
          Archivo acumulativo de artículos revisados por pares sobre selección
          fiable de modelos, aprendizaje en grafos y predicción ambiental.
        </p>
        <div class="record-stats">
          <span><strong>{publications.length}</strong> artículos</span>
          <span><strong>{years.length}</strong> años</span>
          <span><strong>{publications.length}</strong> registros DOI</span>
        </div>
      </div>
    </div>
  </header>

  <section class="publication-note">
    <div class="container note-grid">
      <p>
        <strong>Identidad de autor:</strong> Marc Semper Lloret publica su
        trabajo científico como <strong>Marc Semper</strong>. Registro revisado
        el {publicationRecordReviewedEs}.
      </p>
      <div>
        <a href="/rss.xml">RSS</a>
        <a href={site.profiles.scholar} target="_blank" rel="noopener">Google Scholar</a>
        <a href={site.profiles.orcid} target="_blank" rel="noopener">ORCID</a>
      </div>
    </div>
  </section>

  <div class="container publication-years">
    {years.map((year) => (
      <section class="year-section" aria-labelledby={`year-${year}`}>
        <div class="year-heading">
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{publicationsByYear.get(year)?.length} artículos</span>
        </div>
        <div>
          {publicationsByYear.get(year)?.map((publication, index) => (
            <PublicationCard publication={publication} index={index} lang="es" />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .publications-hero {
    background:
      radial-gradient(circle at 84% 20%, rgba(235, 93, 68, 0.12), transparent 18rem),
      var(--paper);
  }

  .record-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .record-stats span {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .publication-note {
    padding: 25px 0;
    color: var(--white);
    background: var(--blue);
  }

  .note-grid {
    display: flex;
    gap: 30px;
    align-items: center;
    justify-content: space-between;
  }

  .note-grid p {
    margin: 0;
    font-size: 0.78rem;
  }

  .note-grid > div {
    display: flex;
    gap: 18px;
  }

  .note-grid a {
    color: var(--white);
    font-size: 0.72rem;
  }

  .publication-years {
    padding-top: 80px;
    padding-bottom: 110px;
  }

  .year-section + .year-section {
    margin-top: 75px;
  }

  .year-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line-strong);
  }

  .year-heading h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 3.6rem;
    font-weight: 400;
  }

  .year-heading span {
    color: var(--ink-soft);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .note-grid {
      display: grid;
    }
  }
</style>
